<UserControl x:Class="Heimdall.UI.Reminders.ReminderDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Heimdall.UI.Controls"
             xmlns:ui="clr-namespace:Heimdall.UI"
             xmlns:vm="clr-namespace:Heimdall.ViewModels"
             xmlns:s="clr-namespace:Heimdall.Services"
             AutomationProperties.Name="{x:Static s:Strings.DetailsName}"
             KeyboardNavigation.TabNavigation="Cycle">

    <!-- Painel de detalhes (o "…" da linha em edição): 350px, raio 16, linhas de 44px. As
         páginas Repetir/Lista/Prioridade/Notas deslizam dentro dele — nunca abre outra janela. -->

    <UserControl.InputBindings>
        <!-- Esc volta uma página; na principal, cancela. -->
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Heimdall;component/Themes/Forms.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ui:InverseBoolToVisibilityConverter x:Key="H.InverseBoolToVis"/>

            <!-- Seta do stepper de hora: 18x11. -->
            <Style x:Key="StepperButton" TargetType="RepeatButton">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
                <Setter Property="Interval" Value="120"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botões do rodapé, 34px. -->
            <Style x:Key="FooterCancel" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
                <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FooterConfirm" TargetType="Button" BasedOn="{StaticResource FooterCancel}">
                <Setter Property="Foreground" Value="{DynamicResource H.Brush.OnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource H.Brush.Accent}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Lista de opções com check (Repetir, Lista, Prioridade). -->
            <Style x:Key="OptionList" TargetType="ListBox" BasedOn="{StaticResource H.BareList}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource OptionRowStyle}"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
            </Style>

            <!-- ===================== Páginas ===================== -->
            <!-- O Content de cada página é o enum; o DataContext volta a ser o painel. -->

            <DataTemplate x:Key="MainPage">
                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <!-- 1. Data + calendário inline -->
                    <ToggleButton Style="{StaticResource DetailSwitchRowStyle}" Content="{x:Static s:Strings.DetailsDate}"
                                  IsChecked="{Binding Editor.HasDate}" ui:FocusOnLoad.Enabled="True"
                                  AutomationProperties.Name="{x:Static s:Strings.DetailsDate}"/>
                    <c:CalendarInline SelectedDate="{Binding Editor.Date}" Margin="12,2,12,10"
                                      Visibility="{Binding Editor.HasDate, Converter={StaticResource H.BoolToVis}}"/>

                    <!-- 2. Hora: campo mono 13 + stepper ▲▼ -->
                    <ToggleButton Style="{StaticResource DetailSwitchRowStyle}" Content="{x:Static s:Strings.DetailsTime}"
                                  IsChecked="{Binding Editor.HasTime}" AutomationProperties.Name="{x:Static s:Strings.DetailsTime}"/>
                    <StackPanel Orientation="Horizontal" Margin="12,0,12,10"
                                Visibility="{Binding Editor.HasTime, Converter={StaticResource H.BoolToVis}}">
                        <TextBox Style="{StaticResource H.MonoField}" FontSize="13" Width="72" TextAlignment="Center"
                                 Text="{Binding Editor.TimeText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static s:Strings.DetailsTime}"/>
                        <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                            <RepeatButton Style="{StaticResource StepperButton}" Command="{Binding Editor.StepTimeCommand}" CommandParameter="15"
                                          AutomationProperties.Name="{x:Static s:Strings.TimeLater}" ToolTip="{x:Static s:Strings.TimeLater}">
                                <c:Icon Geometry="{DynamicResource H.Icon.ChevronUp}" Size="10" StrokeThickness="2.2"/>
                            </RepeatButton>
                            <RepeatButton Style="{StaticResource StepperButton}" Command="{Binding Editor.StepTimeCommand}" CommandParameter="-15"
                                          Margin="0,2,0,0"
                                          AutomationProperties.Name="{x:Static s:Strings.TimeEarlier}" ToolTip="{x:Static s:Strings.TimeEarlier}">
                                <c:Icon Geometry="{DynamicResource H.Icon.ChevronDown}" Size="10" StrokeThickness="2.2"/>
                            </RepeatButton>
                        </StackPanel>
                    </StackPanel>

                    <!-- 3. Repetir -->
                    <Button Style="{StaticResource DetailRowStyle}" Content="{x:Static s:Strings.DetailsRepeat}"
                            Tag="{Binding Editor.SelectedRepeat.Label}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:DetailsPage.Repeat}"
                            AutomationProperties.Name="{x:Static s:Strings.DetailsRepeat}"
                            AutomationProperties.HelpText="{Binding Editor.SelectedRepeat.Label}"/>

                    <!-- 4. Lista: bolinha + nome -->
                    <Button Style="{StaticResource DetailRowStyle}" Content="{x:Static s:Strings.DetailsList}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:DetailsPage.List}"
                            AutomationProperties.Name="{x:Static s:Strings.DetailsList}"
                            AutomationProperties.HelpText="{Binding Editor.ListName}">
                        <Button.Tag>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding Editor.ListBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Editor.ListName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button.Tag>
                    </Button>

                    <!-- 5. Prioridade -->
                    <Button Style="{StaticResource DetailRowStyle}" Content="{x:Static s:Strings.DetailsPriority}"
                            Tag="{Binding Editor.SelectedPriority.Label}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:DetailsPage.Priority}"
                            AutomationProperties.Name="{x:Static s:Strings.DetailsPriority}"
                            AutomationProperties.HelpText="{Binding Editor.SelectedPriority.Label}"/>

                    <!-- 6. Notas: "Adicionar" apagado quando vazia -->
                    <Button Style="{StaticResource DetailRowStyle}" Content="{x:Static s:Strings.DetailsNotes}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:DetailsPage.Notes}"
                            AutomationProperties.Name="{x:Static s:Strings.DetailsNotes}"
                            AutomationProperties.HelpText="{Binding Editor.NotePreview}">
                        <Button.Tag>
                            <TextBlock Text="{Binding Editor.NotePreview}" TextTrimming="CharacterEllipsis" MaxWidth="170">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editor.HasNote}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource H.Brush.Muted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Tag>
                    </Button>

                    <!-- 7. Sinalizar -->
                    <ToggleButton Style="{StaticResource DetailSwitchRowStyle}" Content="{x:Static s:Strings.DetailsFlag}"
                                  IsChecked="{Binding Editor.Flagged}" AutomationProperties.Name="{x:Static s:Strings.DetailsFlag}"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="RepeatPage">
                <ListBox DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Style="{StaticResource OptionList}" ItemsSource="{Binding Editor.RepeatOptions}"
                         SelectedItem="{Binding Editor.SelectedRepeat}" DisplayMemberPath="Label"
                         AutomationProperties.Name="{x:Static s:Strings.DetailsRepeat}"/>
            </DataTemplate>

            <DataTemplate x:Key="ListPage">
                <ListBox DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Style="{StaticResource OptionList}" ItemsSource="{Binding Editor.ListOptions}"
                         SelectedItem="{Binding Editor.SelectedList}" AutomationProperties.Name="{x:Static s:Strings.DetailsList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Name}">
                                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DataTemplate>

            <DataTemplate x:Key="PriorityPage">
                <ListBox DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Style="{StaticResource OptionList}" ItemsSource="{Binding Editor.PriorityOptions}"
                         SelectedItem="{Binding Editor.SelectedPriority}" DisplayMemberPath="Label"
                         AutomationProperties.Name="{x:Static s:Strings.DetailsPriority}"/>
            </DataTemplate>

            <DataTemplate x:Key="NotesPage">
                <TextBox DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Text="{Binding Editor.Note, UpdateSourceTrigger=PropertyChanged}" Margin="12,4,12,8"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" ui:FocusOnLoad.Enabled="True"
                         AutomationProperties.Name="{x:Static s:Strings.ReminderNoteField}"/>
            </DataTemplate>

            <c:DetailsPageTemplateSelector x:Key="Pages" Main="{StaticResource MainPage}" Repeat="{StaticResource RepeatPage}"
                                           List="{StaticResource ListPage}" Priority="{StaticResource PriorityPage}"
                                           Notes="{StaticResource NotesPage}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Margem transparente pra sombra (0 18 40) não ser cortada pelo popup. -->
    <Border Width="350" CornerRadius="16" Margin="0,4,24,40" Padding="6"
            Background="{DynamicResource H.Brush.Elevated}" BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="1"
            Effect="{StaticResource H.Shadow.Popup}">
        <DockPanel>
            <!-- Cabeçalho "‹ Repetir" das subpáginas -->
            <Button DockPanel.Dock="Top" Style="{StaticResource FooterCancel}" HorizontalAlignment="Left" Padding="6,0,10,0"
                    Command="{Binding BackCommand}" Foreground="{DynamicResource H.Brush.Accent}"
                    AutomationProperties.Name="{x:Static s:Strings.DetailsBack}"
                    Visibility="{Binding IsMainPage, Converter={StaticResource H.InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Geometry="{DynamicResource H.Icon.ChevronLeft}" Size="14" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <!-- Rodapé: Cancelar | Adicionar -->
            <DockPanel DockPanel.Dock="Bottom" Margin="6,8,6,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource FooterConfirm}" Content="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}"/>
                <Button Style="{StaticResource FooterCancel}" Content="{x:Static s:Strings.DetailsCancel}" HorizontalAlignment="Left"
                        Command="{Binding CancelCommand}"/>
            </DockPanel>

            <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" Focusable="False">
                <c:SlideContentControl Content="{Binding Page}" ContentTemplateSelector="{StaticResource Pages}"
                                       SlideBack="{Binding IsNavigatingBack}" Focusable="False" IsTabStop="False"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
