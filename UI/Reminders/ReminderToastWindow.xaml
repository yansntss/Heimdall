<Window x:Class="Heimdall.UI.Reminders.ReminderToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Heimdall.UI.Controls"
        xmlns:s="clr-namespace:Heimdall.Services"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        Width="372" SizeToContent="Height"
        AutomationProperties.Name="{Binding AccessibleName}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Ações do aviso: 28px, raio 8. Primária no acento, secundária neutra. -->
        <Style x:Key="ToastButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
            <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
            <Setter Property="FontSize" Value="{DynamicResource H.FontSize.S}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource H.Brush.Field}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToastPrimary" TargetType="Button" BasedOn="{StaticResource ToastButton}">
            <Setter Property="Foreground" Value="{DynamicResource H.Brush.OnAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource H.Brush.Accent}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margem transparente pra sombra não ser cortada. -->
    <Border x:Name="Card" Margin="16,12,16,28" CornerRadius="13" Padding="14,12,10,12"
            Background="{DynamicResource H.Brush.Elevated}" BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="1"
            Effect="{StaticResource H.Shadow.Popup}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sino em círculo de 28px no acento -->
            <Grid Width="28" Height="28" VerticalAlignment="Top">
                <Ellipse Fill="{DynamicResource H.Brush.Accent}"/>
                <c:Icon Geometry="{DynamicResource H.Icon.Bell}" Size="14" Foreground="{DynamicResource H.Brush.OnAccent}"/>
            </Grid>

            <!-- Título 12.5 bold + meta 11.5; clique abre a janela de lembretes -->
            <StackPanel Grid.Column="1" Margin="12,0,6,0" Background="Transparent" Cursor="Hand">
                <StackPanel.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                </StackPanel.InputBindings>
                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource H.Font.UI}" FontSize="12.5" FontWeight="Bold"
                           Foreground="{DynamicResource H.Brush.Text}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Meta}" FontFamily="{DynamicResource H.Font.UI}" FontSize="11.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource H.Brush.TextSecondary}" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Fechar -->
            <Button Grid.Column="2" Style="{DynamicResource H.IconButton}" Width="22" Height="22" VerticalAlignment="Top"
                    Focusable="False" Command="{Binding CloseCommand}"
                    AutomationProperties.Name="{x:Static s:Strings.ToastClose}" ToolTip="{x:Static s:Strings.ToastClose}">
                <c:Icon Geometry="{DynamicResource H.Icon.Close}" Size="12" Foreground="{DynamicResource H.Brush.TextTertiary}"/>
            </Button>

            <!-- Ações: secundária | primária -->
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,4,0">
                <Button Style="{StaticResource ToastButton}" Content="{Binding SecondaryLabel}" Command="{Binding SecondaryCommand}"
                        AutomationProperties.Name="{Binding SecondaryLabel}"/>
                <Button Style="{StaticResource ToastPrimary}" Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}"
                        AutomationProperties.Name="{Binding PrimaryLabel}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
