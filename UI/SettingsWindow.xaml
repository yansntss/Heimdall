<Window x:Class="Heimdall.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Heimdall.UI.Controls"
        xmlns:ui="clr-namespace:Heimdall.UI"
        xmlns:st="clr-namespace:Heimdall.UI.Settings"
        xmlns:s="clr-namespace:Heimdall.Services"
        Title="Heimdall — Configurações"
        Icon="pack://application:,,,/Assets/heimdall.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Width="1000" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <!-- Chrome próprio: barra de título de 40px arrastável (com snap/duplo clique do
         Windows) e bordas de redimensionar, sem a moldura padrão. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Forms.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ui:SectionVisibilityConverter x:Key="SectionVisibility"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate x:Key="WidgetRowTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" FontSize="13"/>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                    <c:Icon Geometry="{DynamicResource H.Icon.Pin}" Size="12" Margin="8,0,0,0" Foreground="{DynamicResource H.Brush.Accent}"
                            Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="SectionScroll" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Padding" Value="32,8,32,24"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>

            <!-- Checkbox das colunas da tabela de lembretes (o DataGrid ignora o estilo implícito). -->
            <Style x:Key="TableCheck" TargetType="CheckBox" BasedOn="{StaticResource H.TaskCheck}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Atalho em "tecla": fundo de campo, mono. -->
            <Style x:Key="KeyChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource H.Brush.Field}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="{DynamicResource H.Radius.Window}" Background="{DynamicResource H.Brush.Surface}"
            BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Sidebar ================= -->
            <Border Grid.RowSpan="3" Background="{DynamicResource H.Brush.Sidebar}" BorderBrush="{DynamicResource H.Brush.Line}"
                    BorderThickness="0,0,1,0" CornerRadius="14,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="16,0,0,0">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource H.Brush.AccentWash}" VerticalAlignment="Center">
                            <c:Icon Geometry="{DynamicResource H.Icon.Sword}" Size="16" Foreground="{DynamicResource H.Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="Heimdall" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Rodapé: versão + runtime -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionInfo}" Style="{StaticResource H.FieldHint}"
                               FontFamily="{DynamicResource H.Font.Mono}" Foreground="{DynamicResource H.Brush.TextTertiary}"
                               Margin="18,0,12,16" TextTrimming="CharacterEllipsis"/>

                    <ListBox x:Name="NavList" Style="{StaticResource H.BareList}" ItemContainerStyle="{StaticResource H.NavItem}"
                             ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             Margin="10,10,10,0" KeyboardNavigation.TabNavigation="Once"
                             AutomationProperties.Name="{x:Static s:Strings.SettingsTitleBar}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Label}">
                                    <c:Icon Geometry="{Binding IconKey, Converter={x:Static ui:ResourceKeyConverter.Instance}}" Size="16"/>
                                    <TextBlock Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ================= Barra de título (botões 34x28) ================= -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource H.CaptionButton}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{x:Static s:Strings.WindowMinimize}" ToolTip="{x:Static s:Strings.WindowMinimize}">
                    <c:Icon Geometry="{DynamicResource H.Icon.Minus}" Size="14"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource H.CaptionButton}" Click="Maximize_Click" Margin="2,0"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{x:Static s:Strings.WindowMaximize}" ToolTip="{x:Static s:Strings.WindowMaximize}">
                    <c:Icon x:Name="MaximizeIcon" Geometry="{DynamicResource H.Icon.Maximize}" Size="12"/>
                </Button>
                <Button Style="{StaticResource H.CaptionCloseButton}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{x:Static s:Strings.WindowClose}" ToolTip="{x:Static s:Strings.WindowClose}">
                    <c:Icon Geometry="{DynamicResource H.Icon.Close}" Size="14"/>
                </Button>
            </StackPanel>

            <!-- ================= Conteúdo ================= -->
            <Grid Grid.Column="1" Grid.Row="1">

                <!-- ===== Geral ===== -->
                <ScrollViewer Style="{StaticResource SectionScroll}"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=geral}">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static s:Strings.SectionGeral}" Style="{StaticResource H.SectionTitle}" Margin="0,0,0,20"/>

                        <Border Style="{StaticResource H.SettingsCard}" Padding="16,6" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="FloatingModeCheck" Margin="0,8" Checked="FloatingModeCheck_Changed" Unchecked="FloatingModeCheck_Changed"
                                          AutomationProperties.Name="{x:Static s:Strings.LabelFloatingMode}">
                                    <TextBlock Text="{x:Static s:Strings.LabelFloatingMode}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <Border Style="{StaticResource H.Divider}"/>
                                <StackPanel Margin="0,10,0,10">
                                    <TextBlock Text="{x:Static s:Strings.LabelFloatingMargin}" Style="{StaticResource H.FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="FloatingMarginSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Static s:Strings.LabelFloatingMargin}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=FloatingMarginSlider, Path=Value, StringFormat={}{0:0}}"
                                                   Style="{StaticResource H.MonoValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Static s:Strings.LabelMonitorMode}" Style="{StaticResource H.FieldLabel}"/>
                        <ComboBox x:Name="MonitorModeCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="220"
                                  SelectionChanged="MonitorModeCombo_SelectionChanged" AutomationProperties.Name="{x:Static s:Strings.LabelMonitorMode}"/>

                        <TextBlock Text="{x:Static s:Strings.LabelMonitorSpecific}" Style="{StaticResource H.FieldLabel}"/>
                        <ComboBox x:Name="MonitorCombo" Margin="0,0,0,16" AutomationProperties.Name="{x:Static s:Strings.LabelMonitorSpecific}"/>

                        <TextBlock Text="{x:Static s:Strings.LabelLanguage}" Style="{StaticResource H.FieldLabel}"/>
                        <ComboBox x:Name="LanguageCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="220"
                                  AutomationProperties.Name="{x:Static s:Strings.LabelLanguage}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Aparência (MVVM) ===== -->
                <ScrollViewer Style="{StaticResource SectionScroll}"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=aparencia}">
                    <st:AppearancePanel DataContext="{Binding Appearance}"/>
                </ScrollViewer>

                <!-- ===== Relógio ===== -->
                <ScrollViewer Style="{StaticResource SectionScroll}"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=relogio}">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static s:Strings.SectionRelogio}" Style="{StaticResource H.SectionTitle}" Margin="0,0,0,20"/>

                        <TextBlock Text="{x:Static s:Strings.LabelClockMode}" Style="{StaticResource H.FieldLabel}"/>
                        <ComboBox x:Name="ClockModeCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="220"
                                  SelectionChanged="ClockModeCombo_SelectionChanged" AutomationProperties.Name="{x:Static s:Strings.LabelClockMode}"/>

                        <TextBlock Text="{x:Static s:Strings.LabelClockStyle}" Style="{StaticResource H.FieldLabel}"/>
                        <ComboBox x:Name="ClockStyleCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="220"
                                  SelectionChanged="ClockStyleCombo_SelectionChanged" AutomationProperties.Name="{x:Static s:Strings.LabelClockStyle}"/>

                        <TextBlock Text="{x:Static s:Strings.LabelClockCulture}" Style="{StaticResource H.FieldLabel}"/>
                        <TextBox x:Name="ClockCultureBox" Margin="0,0,0,16" Width="220" HorizontalAlignment="Left"
                                 TextChanged="ClockCultureBox_TextChanged" AutomationProperties.Name="{x:Static s:Strings.LabelClockCulture}"/>

                        <TextBlock Text="{x:Static s:Strings.LabelClockCustomFormat}" Style="{StaticResource H.FieldLabel}"/>
                        <TextBox x:Name="ClockCustomFormatBox" Margin="0,0,0,20" Width="340" HorizontalAlignment="Left"
                                 FontFamily="{DynamicResource H.Font.Mono}"
                                 TextChanged="ClockCustomFormatBox_TextChanged" AutomationProperties.Name="{x:Static s:Strings.LabelClockCustomFormat}"/>

                        <TextBlock Text="{x:Static s:Strings.LabelPreviewSection}" Style="{StaticResource H.FieldLabel}"/>
                        <Border Style="{StaticResource H.SettingsCard}" HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static s:Strings.PreviewHorizontal}" Foreground="{DynamicResource H.Brush.TextSecondary}"/>
                                    <TextBlock x:Name="ClockPreviewHorizontal" Style="{StaticResource H.MonoValue}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{x:Static s:Strings.PreviewVertical}" Foreground="{DynamicResource H.Brush.TextSecondary}"/>
                                    <TextBlock x:Name="ClockPreviewVertical" Style="{StaticResource H.MonoValue}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Widgets ===== -->
                <ScrollViewer Style="{StaticResource SectionScroll}"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=widgets}">
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.SectionWidgets}" Style="{StaticResource H.SectionTitle}"/>
                        <TextBlock Text="{x:Static s:Strings.HintWidgets}" Style="{StaticResource H.SectionSubtitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static s:Strings.ZoneStart}" Style="{StaticResource H.FieldLabel}"/>
                                <ListBox x:Name="StartList" Height="260" ItemTemplate="{StaticResource WidgetRowTemplate}"
                                         AutomationProperties.Name="{x:Static s:Strings.ZoneStart}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource H.IconButton}" Click="TogglePin_Click" Tag="{Binding ElementName=StartList}"
                                            ToolTip="{x:Static s:Strings.TogglePinTooltip}" AutomationProperties.Name="{x:Static s:Strings.TogglePinTooltip}">
                                        <c:Icon Geometry="{DynamicResource H.Icon.Pin}" Size="14"/>
                                    </Button>
                                    <Button Content="{x:Static s:Strings.Remove}" Click="Remove_Click" Tag="{Binding ElementName=StartList}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource H.DashedButton}" Margin="0,8,0,0" Click="AddStart_Click" Content="{x:Static s:Strings.AddWidgetButton}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Text="{x:Static s:Strings.ZoneCenter}" Style="{StaticResource H.FieldLabel}"/>
                                <ListBox x:Name="CenterList" Height="260" ItemTemplate="{StaticResource WidgetRowTemplate}"
                                         AutomationProperties.Name="{x:Static s:Strings.ZoneCenter}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource H.IconButton}" Click="TogglePin_Click" Tag="{Binding ElementName=CenterList}"
                                            ToolTip="{x:Static s:Strings.TogglePinTooltip}" AutomationProperties.Name="{x:Static s:Strings.TogglePinTooltip}">
                                        <c:Icon Geometry="{DynamicResource H.Icon.Pin}" Size="14"/>
                                    </Button>
                                    <Button Content="{x:Static s:Strings.Remove}" Click="Remove_Click" Tag="{Binding ElementName=CenterList}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource H.DashedButton}" Margin="0,8,0,0" Click="AddCenter_Click" Content="{x:Static s:Strings.AddWidgetButton}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="{x:Static s:Strings.ZoneEnd}" Style="{StaticResource H.FieldLabel}"/>
                                <ListBox x:Name="EndList" Height="260" ItemTemplate="{StaticResource WidgetRowTemplate}"
                                         AutomationProperties.Name="{x:Static s:Strings.ZoneEnd}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource H.IconButton}" Click="TogglePin_Click" Tag="{Binding ElementName=EndList}"
                                            ToolTip="{x:Static s:Strings.TogglePinTooltip}" AutomationProperties.Name="{x:Static s:Strings.TogglePinTooltip}">
                                        <c:Icon Geometry="{DynamicResource H.Icon.Pin}" Size="14"/>
                                    </Button>
                                    <Button Content="{x:Static s:Strings.Remove}" Click="Remove_Click" Tag="{Binding ElementName=EndList}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource H.DashedButton}" Margin="0,8,0,0" Click="AddEnd_Click" Content="{x:Static s:Strings.AddWidgetButton}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Lembretes ===== -->
                <Grid Margin="32,8,32,24"
                      Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=lembretes}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static s:Strings.SectionLembretes}" Style="{StaticResource H.SectionTitle}" Margin="0,0,0,16"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{x:Static s:Strings.AddReminder}" Margin="0,0,8,0" Click="AddReminder_Click"/>
                        <Button Content="{x:Static s:Strings.RemoveSelected}" Click="RemoveReminder_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="RemindersGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0"
                              AutomationProperties.Name="{x:Static s:Strings.SectionLembretes}">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn x:Name="KindColumn" Header="{x:Static s:Strings.ColumnType}" SelectedItemBinding="{Binding Kind}" Width="90"/>
                            <DataGridTextColumn Header="{x:Static s:Strings.ColumnText}" Binding="{Binding Text}" Width="*"/>
                            <DataGridTextColumn Header="{x:Static s:Strings.ColumnTime}" Binding="{Binding Time}" Width="110"/>
                            <DataGridComboBoxColumn x:Name="RecurrenceColumn" Header="{x:Static s:Strings.ColumnRecurrence}" SelectedItemBinding="{Binding Recurrence}" Width="100"/>
                            <DataGridTextColumn Header="{x:Static s:Strings.ColumnDays}" Binding="{Binding Days}" Width="140"/>
                            <DataGridCheckBoxColumn Header="{x:Static s:Strings.ColumnSound}" Binding="{Binding PlaySound}" Width="50"
                                                    ElementStyle="{StaticResource TableCheck}" EditingElementStyle="{StaticResource TableCheck}"/>
                            <DataGridCheckBoxColumn Header="{x:Static s:Strings.ColumnCompleted}" Binding="{Binding Completed}" Width="80"
                                                    ElementStyle="{StaticResource TableCheck}" EditingElementStyle="{StaticResource TableCheck}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ===== Atalhos ===== -->
                <ScrollViewer Style="{StaticResource SectionScroll}"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=atalhos}">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static s:Strings.SectionAtalhos}" Style="{StaticResource H.SectionTitle}"/>
                        <TextBlock Text="{x:Static s:Strings.AtalhosSubtitle}" Style="{StaticResource H.SectionSubtitle}"/>
                        <Border Style="{StaticResource H.SettingsCard}" Padding="16,4">
                            <ItemsControl x:Name="ShortcutsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10">
                                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center" Foreground="{DynamicResource H.Brush.Text}"/>
                                            <Border Style="{StaticResource KeyChip}">
                                                <TextBlock Text="{Binding Keys}" Style="{StaticResource H.MonoValue}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Sobre ===== -->
                <ScrollViewer Style="{StaticResource SectionScroll}"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=sobre}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0">
                        <Image Source="pack://application:,,,/Assets/heimdall-logo.png" Width="220" Stretch="Uniform" Margin="0,0,0,20"/>
                        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Style="{StaticResource H.MonoValue}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static s:Strings.AppTagline}" HorizontalAlignment="Center" Style="{StaticResource H.FieldHint}" Margin="0,0,0,20"/>
                        <Button Content="{x:Static s:Strings.ViewOnGitHub}" HorizontalAlignment="Center" Click="OpenGitHub_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= Rodapé ================= -->
            <Border Grid.Column="1" Grid.Row="2" BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="0,1,0,0" Padding="24,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{x:Static s:Strings.RestoreDefaults}" Click="RestoreDefaults_Click" Style="{StaticResource H.ListButton}"
                                Height="32" Padding="12,0" Margin="0,0,8,0" HorizontalContentAlignment="Center"
                                Foreground="{DynamicResource H.Brush.TextSecondary}"/>
                        <Button Content="{x:Static s:Strings.Cancel}" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="96"/>
                        <Button Content="{x:Static s:Strings.Apply}" Click="Apply_Click" Style="{StaticResource H.PrimaryButton}" MinWidth="110"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource H.FieldHint}" Foreground="{DynamicResource H.Brush.Ok}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
