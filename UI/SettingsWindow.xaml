<Window x:Class="Heimdall.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heimdall — Configurações"
        Icon="pack://application:,,,/Assets/heimdall.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F1318">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate x:Key="WidgetRowTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" FontSize="13"/>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                    <TextBlock Text="📌" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10"
                               Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource HeimdallBorder}" BorderThickness="1">
        <DockPanel>
            <!-- ================= Barra de título customizada ================= -->
            <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource HeimdallSidebarBackground}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/heimdall.ico" Width="18" Height="18"/>
                        <TextBlock x:Name="TitleBarText" Text="Configurações — Heimdall" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Width="42" Height="40" Style="{StaticResource HeimdallIconButton}" Click="Minimize_Click"/>
                        <Button Content="✕" Width="42" Height="40" Style="{StaticResource HeimdallCloseButton}" Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Rodapé fixo ================= -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource HeimdallSidebarBackground}" Padding="20,12"
                    BorderBrush="{StaticResource HeimdallBorder}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource HeimdallHint}"
                               Foreground="{StaticResource HeimdallAccentSecondary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Cancelar" Width="100" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource HeimdallSecondaryButton}"/>
                        <Button x:Name="SaveButton" Content="Salvar e recarregar" Width="170" Click="Save_Click" Style="{StaticResource HeimdallPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Corpo: navegação + conteúdo ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Navegação lateral ===== -->
                <Border Grid.Column="0" Background="{StaticResource HeimdallSidebarBackground}"
                        BorderBrush="{StaticResource HeimdallBorder}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,14,0,0">
                        <RadioButton x:Name="NavGeral" Content="Geral" GroupName="Nav" Style="{StaticResource HeimdallNavItem}" IsChecked="True" Checked="Nav_Changed"/>
                        <RadioButton x:Name="NavAparencia" Content="Aparência" GroupName="Nav" Style="{StaticResource HeimdallNavItem}" Checked="Nav_Changed"/>
                        <RadioButton x:Name="NavRelogio" Content="Relógio" GroupName="Nav" Style="{StaticResource HeimdallNavItem}" Checked="Nav_Changed"/>
                        <RadioButton x:Name="NavWidgets" Content="Widgets" GroupName="Nav" Style="{StaticResource HeimdallNavItem}" Checked="Nav_Changed"/>
                        <RadioButton x:Name="NavLembretes" Content="Lembretes" GroupName="Nav" Style="{StaticResource HeimdallNavItem}" Checked="Nav_Changed"/>
                        <RadioButton x:Name="NavSobre" Content="Sobre" GroupName="Nav" Style="{StaticResource HeimdallNavItem}" Checked="Nav_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ===== Conteúdo (uma seção visível por vez) ===== -->
                <Grid Grid.Column="1">

                    <!-- ================= GERAL ================= -->
                    <ScrollViewer x:Name="GeralSection" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                            <TextBlock x:Name="GeralTitle" Text="Geral" Style="{StaticResource HeimdallSectionTitle}"/>

                            <TextBlock x:Name="EdgeLabel" Text="Borda" Style="{StaticResource HeimdallLabel}"/>
                            <ComboBox x:Name="EdgeCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="180"/>

                            <TextBlock x:Name="ThicknessLabel" Text="Espessura (DIPs)" Style="{StaticResource HeimdallLabel}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ThicknessSlider" Minimum="16" Maximum="400"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=ThicknessSlider, Path=Value, StringFormat={}{0:0}}"
                                           Style="{StaticResource HeimdallMonoValue}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <CheckBox x:Name="FloatingModeCheck" Content="Modo flutuante (margem das bordas + cantos arredondados)"
                                      Margin="0,0,0,12" Checked="FloatingModeCheck_Changed" Unchecked="FloatingModeCheck_Changed"/>

                            <TextBlock x:Name="FloatingMarginLabel" Text="Margem flutuante (DIPs)" Style="{StaticResource HeimdallLabel}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FloatingMarginSlider" Minimum="0" Maximum="100"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=FloatingMarginSlider, Path=Value, StringFormat={}{0:0}}"
                                           Style="{StaticResource HeimdallMonoValue}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="MonitorModeLabel" Text="Modo de monitor" Style="{StaticResource HeimdallLabel}"/>
                            <ComboBox x:Name="MonitorModeCombo" Margin="0,0,0,12" HorizontalAlignment="Left" Width="180"
                                      SelectionChanged="MonitorModeCombo_SelectionChanged"/>

                            <TextBlock x:Name="MonitorSpecificLabel" Text="Monitor específico" Style="{StaticResource HeimdallLabel}"/>
                            <ComboBox x:Name="MonitorCombo" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

                            <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar com o Windows" Margin="0,4,0,16"/>

                            <CheckBox x:Name="GamingModeCheck" Content="Ativar modo gaming (overlay em tela cheia)" Margin="0,0,0,4"/>
                            <TextBlock x:Name="GamingModeHint" Text="Quando desativado, a barra some ao abrir um jogo em tela cheia, em vez de virar overlay transparente."
                                       Style="{StaticResource HeimdallHint}" Margin="48,0,0,0"/>

                            <TextBlock x:Name="LanguageLabel" Text="Idioma" Style="{StaticResource HeimdallLabel}" Margin="0,16,0,0"/>
                            <ComboBox x:Name="LanguageCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="180"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= APARÊNCIA ================= -->
                    <ScrollViewer x:Name="AparenciaSection" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22" Visibility="Collapsed">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock x:Name="AparenciaTitle" Text="Aparência" Style="{StaticResource HeimdallSectionTitle}"/>

                            <TextBlock x:Name="PreviewLabel" Text="Prévia" Style="{StaticResource HeimdallLabel}"/>
                            <Border x:Name="PreviewBar" Width="340" Height="40" CornerRadius="6" Margin="0,0,0,20"
                                    HorizontalAlignment="Left" ClipToBounds="True">
                                <Grid Margin="10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="PreviewDot" Width="8" Height="8" Fill="{StaticResource HeimdallAccent}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PreviewTitle" Text="Heimdall"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewClock" Text="12:34" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ThemeLabel" Text="Tema" Style="{StaticResource HeimdallLabel}"/>
                            <ItemsControl x:Name="ThemeCardsList" Margin="0,0,0,20">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="ThemeCard_Click" Tag="{Binding Name}" Style="{StaticResource HeimdallIconButton}"
                                                Margin="0,0,8,8" Padding="0" ToolTip="{Binding Name}">
                                            <Border Width="92" Height="60" CornerRadius="6" Background="{Binding Background}"
                                                    BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}">
                                                <StackPanel VerticalAlignment="Bottom" Margin="8">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Accent}" Margin="0,0,4,0"/>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Text}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Text}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="OverridesLabel" Text="Overrides opcionais (vazio = usa o tema)" Style="{StaticResource HeimdallLabel}" Margin="0,0,0,10"/>

                            <TextBlock x:Name="BackgroundColorHint" Text="Cor de fundo" Style="{StaticResource HeimdallHint}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                                <Button x:Name="BackgroundSwatchButton" Width="30" Height="26" Margin="0,0,8,0" Click="BackgroundSwatch_Click"
                                        Style="{StaticResource HeimdallIconButton}" ToolTip="Escolher cor">
                                    <Border x:Name="BackgroundSwatch" Width="20" Height="20" CornerRadius="3"
                                            BorderBrush="{StaticResource HeimdallBorder}" BorderThickness="1"/>
                                </Button>
                                <TextBox x:Name="BackgroundHexBox" Width="130" TextChanged="BackgroundHexBox_TextChanged"/>
                                <Button x:Name="ClearBackgroundButton" Content="Limpar" Width="64" Margin="8,0,0,0" Click="ClearBackground_Click"/>
                            </DockPanel>

                            <TextBlock x:Name="ForegroundColorHint" Text="Cor do texto" Style="{StaticResource HeimdallHint}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                                <Button x:Name="ForegroundSwatchButton" Width="30" Height="26" Margin="0,0,8,0" Click="ForegroundSwatch_Click"
                                        Style="{StaticResource HeimdallIconButton}" ToolTip="Escolher cor">
                                    <Border x:Name="ForegroundSwatch" Width="20" Height="20" CornerRadius="3"
                                            BorderBrush="{StaticResource HeimdallBorder}" BorderThickness="1"/>
                                </Button>
                                <TextBox x:Name="ForegroundHexBox" Width="130" TextChanged="ForegroundHexBox_TextChanged"/>
                                <Button x:Name="ClearForegroundButton" Content="Limpar" Width="64" Margin="8,0,0,0" Click="ClearForeground_Click"/>
                            </DockPanel>

                            <TextBlock x:Name="FontLabel" Text="Fonte" Style="{StaticResource HeimdallLabel}"/>
                            <ComboBox x:Name="FontFamilyCombo" IsEditable="True" Margin="0,0,0,14" HorizontalAlignment="Left" Width="220"
                                      SelectionChanged="FontFamilyCombo_Changed" LostFocus="FontFamilyCombo_Changed"/>

                            <CheckBox x:Name="CustomFontSizeCheck" Content="Personalizar tamanho da fonte" Margin="0,0,0,8"
                                      Checked="CustomFontSizeCheck_Changed" Unchecked="CustomFontSizeCheck_Changed"/>
                            <Grid Margin="0,0,0,4" Width="260" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="72" ValueChanged="FontSizeSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=FontSizeSlider, Path=Value, StringFormat={}{0:0}}"
                                           Style="{StaticResource HeimdallMonoValue}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= RELÓGIO ================= -->
                    <ScrollViewer x:Name="RelogioSection" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22" Visibility="Collapsed">
                        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                            <TextBlock x:Name="RelogioTitle" Text="Relógio" Style="{StaticResource HeimdallSectionTitle}"/>

                            <TextBlock x:Name="ClockModeLabel" Text="Modo" Style="{StaticResource HeimdallLabel}"/>
                            <ComboBox x:Name="ClockModeCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="180"
                                      SelectionChanged="ClockModeCombo_SelectionChanged"/>

                            <TextBlock x:Name="ClockStyleLabel" Text="Estilo" Style="{StaticResource HeimdallLabel}"/>
                            <ComboBox x:Name="ClockStyleCombo" Margin="0,0,0,16" HorizontalAlignment="Left" Width="180"
                                      SelectionChanged="ClockStyleCombo_SelectionChanged"/>

                            <TextBlock x:Name="ClockCultureLabel" Text="Cultura (ex.: pt-BR, en-US)" Style="{StaticResource HeimdallLabel}"/>
                            <TextBox x:Name="ClockCultureBox" Margin="0,0,0,16" Width="180" HorizontalAlignment="Left"
                                     TextChanged="ClockCultureBox_TextChanged"/>

                            <TextBlock x:Name="ClockCustomFormatLabel" Text="Formato personalizado (.NET) — só com Modo = Custom" Style="{StaticResource HeimdallLabel}"/>
                            <TextBox x:Name="ClockCustomFormatBox" Margin="0,0,0,20" Width="320" HorizontalAlignment="Left"
                                     TextChanged="ClockCustomFormatBox_TextChanged"/>

                            <TextBlock x:Name="ClockPreviewLabel" Text="Pré-visualização" Style="{StaticResource HeimdallLabel}"/>
                            <Border Background="{StaticResource HeimdallPanelBackground}" BorderBrush="{StaticResource HeimdallBorder}"
                                    BorderThickness="1" CornerRadius="4" Padding="14" HorizontalAlignment="Left">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ClockPreviewHorizontalLabel" Text="Barra horizontal:  " FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ClockPreviewHorizontal" Style="{StaticResource HeimdallMonoValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock x:Name="ClockPreviewVerticalLabel" Text="Barra vertical:  " FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ClockPreviewVertical" Style="{StaticResource HeimdallMonoValue}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= WIDGETS ================= -->
                    <ScrollViewer x:Name="WidgetsSection" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="WidgetsTitle" Text="Widgets" Style="{StaticResource HeimdallSectionTitle}"/>
                            <TextBlock x:Name="WidgetsHint" Text="Arraste pra reordenar, inclusive entre colunas. Clique num item e depois no alfinete pra fixar/desafixar."
                                       Style="{StaticResource HeimdallHint}" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="ZoneStartLabel" Text="Início" Style="{StaticResource HeimdallLabel}"/>
                                    <ListBox x:Name="StartList" Height="220" ItemTemplate="{StaticResource WidgetRowTemplate}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="StartPinButton" Content="📌" Width="30" Click="TogglePin_Click" Tag="{Binding ElementName=StartList}" ToolTip="Fixar/desafixar selecionado"/>
                                        <Button x:Name="StartRemoveButton" Content="Remover" Click="Remove_Click" Tag="{Binding ElementName=StartList}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="StartAddWidgetButton" Content="+ Adicionar widget" Margin="0,6,0,0" Click="AddStart_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock x:Name="ZoneCenterLabel" Text="Centro" Style="{StaticResource HeimdallLabel}"/>
                                    <ListBox x:Name="CenterList" Height="220" ItemTemplate="{StaticResource WidgetRowTemplate}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="CenterPinButton" Content="📌" Width="30" Click="TogglePin_Click" Tag="{Binding ElementName=CenterList}" ToolTip="Fixar/desafixar selecionado"/>
                                        <Button x:Name="CenterRemoveButton" Content="Remover" Click="Remove_Click" Tag="{Binding ElementName=CenterList}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="CenterAddWidgetButton" Content="+ Adicionar widget" Margin="0,6,0,0" Click="AddCenter_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock x:Name="ZoneEndLabel" Text="Fim" Style="{StaticResource HeimdallLabel}"/>
                                    <ListBox x:Name="EndList" Height="220" ItemTemplate="{StaticResource WidgetRowTemplate}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="EndPinButton" Content="📌" Width="30" Click="TogglePin_Click" Tag="{Binding ElementName=EndList}" ToolTip="Fixar/desafixar selecionado"/>
                                        <Button x:Name="EndRemoveButton" Content="Remover" Click="Remove_Click" Tag="{Binding ElementName=EndList}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="EndAddWidgetButton" Content="+ Adicionar widget" Margin="0,6,0,0" Click="AddEnd_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= LEMBRETES ================= -->
                    <Grid x:Name="LembretesSection" Margin="28,22,28,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LembretesTitle" Grid.Row="0" Text="Lembretes" Style="{StaticResource HeimdallSectionTitle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddReminderButton" Content="Adicionar lembrete" Margin="0,0,8,0" Click="AddReminder_Click"/>
                            <Button x:Name="RemoveReminderButton" Content="Remover selecionado" Click="RemoveReminder_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="RemindersGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn x:Name="KindColumn" Header="Tipo" SelectedItemBinding="{Binding Kind}" Width="90"/>
                                <DataGridTextColumn x:Name="TextColumn" Header="Texto" Binding="{Binding Text}" Width="*"/>
                                <DataGridTextColumn x:Name="TimeColumn" Header="Horário (HH:mm)" Binding="{Binding Time}" Width="110"/>
                                <DataGridComboBoxColumn x:Name="RecurrenceColumn" Header="Recorrência" SelectedItemBinding="{Binding Recurrence}" Width="100"/>
                                <DataGridTextColumn x:Name="DaysColumn" Header="Dias (Weekly)" Binding="{Binding Days}" Width="150"/>
                                <DataGridCheckBoxColumn x:Name="SoundColumn" Header="Som" Binding="{Binding PlaySound}" Width="45"/>
                                <DataGridCheckBoxColumn x:Name="CompletedColumn" Header="Concluído" Binding="{Binding Completed}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ================= SOBRE ================= -->
                    <ScrollViewer x:Name="SobreSection" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0">
                            <Image Source="pack://application:,,,/Assets/heimdall-logo.png" Width="220" Stretch="Uniform" Margin="0,0,0,20"/>
                            <TextBlock x:Name="VersionText" Text="Versão 1.0.0" HorizontalAlignment="Center"
                                       Style="{StaticResource HeimdallMonoValue}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="AppTaglineText" Text="Barra de sistema leve e personalizável pro Windows." HorizontalAlignment="Center"
                                       Style="{StaticResource HeimdallHint}" Margin="0,0,0,20"/>
                            <Button x:Name="GitHubButton" Content="Ver no GitHub" Width="160" Click="OpenGitHub_Click" Style="{StaticResource HeimdallSecondaryButton}"/>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
