<UserControl x:Class="Heimdall.UI.Settings.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Heimdall.UI.Controls"
             xmlns:ui="clr-namespace:Heimdall.UI"
             xmlns:s="clr-namespace:Heimdall.Services">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Mesclado aqui também (não só na janela): StaticResource é resolvido no
                 InitializeComponent, antes do painel entrar na árvore da janela. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Forms.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ui:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock Text="{x:Static s:Strings.SectionAparencia}" Style="{StaticResource H.SectionTitle}"/>
        <TextBlock Text="{x:Static s:Strings.AppearanceSubtitle}" Style="{StaticResource H.SectionSubtitle}"/>

        <!-- ============ Posição da barra: 4 cards de 78px ============ -->
        <TextBlock Text="{x:Static s:Strings.LabelBarPosition}" Style="{StaticResource H.FieldLabel}"/>
        <ListBox Style="{StaticResource H.BareList}" ItemContainerStyle="{StaticResource H.OptionCard}"
                 ItemsSource="{Binding Edges}" SelectedItem="{Binding SelectedEdge, Mode=TwoWay}"
                 AutomationProperties.Name="{x:Static s:Strings.LabelBarPosition}" Margin="0,0,0,14">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Height="60" AutomationProperties.Name="{Binding Name}">
                        <!-- Mini-diagrama: tela com a borda ativa no acento -->
                        <Border Width="52" Height="34" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource H.Brush.Line}" Background="{DynamicResource H.Brush.Field}">
                            <Border Background="{DynamicResource H.Brush.Accent}" CornerRadius="2" Margin="3"
                                    Width="{Binding BarWidth}" Height="{Binding BarHeight}"
                                    HorizontalAlignment="{Binding BarHorizontal}" VerticalAlignment="{Binding BarVertical}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   FontSize="{DynamicResource H.FontSize.S}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ============ Tema: 4 cards com prévia da barra ============ -->
        <TextBlock Text="{x:Static s:Strings.LabelTheme}" Style="{StaticResource H.FieldLabel}"/>
        <ListBox Style="{StaticResource H.BareList}" ItemContainerStyle="{StaticResource H.OptionCard}"
                 ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                 AutomationProperties.Name="{x:Static s:Strings.LabelTheme}" Margin="0,0,0,14">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel AutomationProperties.Name="{Binding Name}">
                        <!-- "Papel de parede" pra translucidez aparecer na prévia -->
                        <Border Height="52" CornerRadius="6" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B4A6B" Offset="0"/>
                                    <GradientStop Color="#7A5C8E" Offset="0.55"/>
                                    <GradientStop Color="#D99A6C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid VerticalAlignment="Top" Margin="5,5,5,0">
                                <Border Height="{Binding BarHeight}" CornerRadius="4" Background="{Binding Bar}">
                                    <Grid Margin="4,0">
                                        <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Accent}" HorizontalAlignment="Left"/>
                                        <Border Width="34" Height="8" CornerRadius="4" Background="{Binding Chip}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="12:34" FontSize="8" Foreground="{Binding Text}" FontFamily="{DynamicResource H.Font.Mono}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Height="{Binding AccentLine}" Background="{Binding Accent}" VerticalAlignment="Top" CornerRadius="4,4,0,0"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="2,8,0,0" FontSize="{DynamicResource H.FontSize.S}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ============ Opacidade e altura ============ -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel IsEnabled="{Binding IsOpacityEnabled}">
                <TextBlock Text="{x:Static s:Strings.LabelOpacity}" Style="{StaticResource H.FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="20" Maximum="100" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                            Value="{Binding OpacityPercent, Mode=TwoWay}" AutomationProperties.Name="{x:Static s:Strings.LabelOpacity}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBox Style="{StaticResource H.MonoField}" Width="52"
                                 Text="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                 AutomationProperties.Name="{x:Static s:Strings.LabelOpacity}"/>
                        <TextBlock Text="%" Style="{StaticResource H.MonoValue}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource H.Brush.TextSecondary}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{x:Static s:Strings.HintOpacitySolid}" Style="{StaticResource H.FieldHint}" Margin="0,6,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="IsOpacityEnabled">
                            <Binding.Converter>
                                <ui:InverseBoolToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding ThicknessLabel}" Style="{StaticResource H.FieldLabel}"/>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsThicknessEditable}">
                    <Button Style="{StaticResource H.IconButton}" Command="{Binding DecreaseThicknessCommand}"
                            AutomationProperties.Name="{x:Static s:Strings.Decrease}" ToolTip="{x:Static s:Strings.Decrease}">
                        <c:Icon Geometry="{DynamicResource H.Icon.Minus}" Size="14"/>
                    </Button>
                    <TextBox Style="{StaticResource H.MonoField}" Width="56" Margin="6,0"
                             Text="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.Name="{Binding ThicknessLabel}"/>
                    <Button Style="{StaticResource H.IconButton}" Command="{Binding IncreaseThicknessCommand}"
                            AutomationProperties.Name="{x:Static s:Strings.Increase}" ToolTip="{x:Static s:Strings.Increase}">
                        <c:Icon Geometry="{DynamicResource H.Icon.Plus}" Size="14"/>
                    </Button>
                    <TextBlock Text="px" Style="{StaticResource H.MonoValue}" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{DynamicResource H.Brush.TextSecondary}"/>
                </StackPanel>
                <TextBlock Text="{Binding ThicknessHint}" Style="{StaticResource H.FieldHint}" Margin="0,6,0,0" MaxWidth="200"
                           Visibility="{Binding ThicknessHint, Converter={StaticResource EmptyToCollapsed}}"/>
            </StackPanel>
        </Grid>

        <!-- ============ Cor de acento ============ -->
        <TextBlock Text="{x:Static s:Strings.LabelAccent}" Style="{StaticResource H.FieldLabel}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
            <ListBox Style="{StaticResource H.BareList}" ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                     AutomationProperties.Name="{x:Static s:Strings.LabelAccent}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,10,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Width="38" Height="38">
                                        <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="Transparent"/>
                                        <Ellipse Width="30" Height="30" Fill="{Binding Brush}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource H.Brush.Line}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource H.Brush.Text}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Button Command="{Binding UseWindowsAccentCommand}" Margin="6,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static s:Strings.AccentWindows}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource H.SecondaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseWindowsAccent}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Accent}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <c:Icon Geometry="{DynamicResource H.Icon.Monitor}" Size="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static s:Strings.AccentWindows}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ============ Comportamento: switches 36x20 ============ -->
        <TextBlock Text="{x:Static s:Strings.LabelBehavior}" Style="{StaticResource H.FieldLabel}"/>
        <Border Style="{StaticResource H.SettingsCard}" Padding="16,6">
            <StackPanel>
                <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,8"
                          AutomationProperties.Name="{x:Static s:Strings.LabelStartWithWindows}">
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.LabelStartWithWindows}"/>
                        <TextBlock Text="{x:Static s:Strings.HintStartWithWindows}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource H.Divider}"/>
                <CheckBox IsChecked="{Binding ReserveSpace, Mode=TwoWay}" Margin="0,8" IsEnabled="{Binding AutoHide, Converter={x:Static ui:InverseBoolConverter.Instance}}"
                          AutomationProperties.Name="{x:Static s:Strings.LabelReserveSpace}">
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.LabelReserveSpace}"/>
                        <TextBlock Text="{x:Static s:Strings.HintReserveSpace}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource H.Divider}"/>
                <CheckBox IsChecked="{Binding AutoHide, Mode=TwoWay}" Margin="0,8"
                          AutomationProperties.Name="{x:Static s:Strings.LabelAutoHide}">
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.LabelAutoHide}"/>
                        <TextBlock Text="{x:Static s:Strings.HintAutoHide}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource H.Divider}"/>
                <CheckBox IsChecked="{Binding OverlayFullscreen, Mode=TwoWay}" Margin="0,8"
                          AutomationProperties.Name="{x:Static s:Strings.LabelOverlayFullscreen}">
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.LabelOverlayFullscreen}"/>
                        <TextBlock Text="{x:Static s:Strings.HintGamingMode}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
