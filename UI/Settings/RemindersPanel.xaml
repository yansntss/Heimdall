<UserControl x:Class="Heimdall.UI.Settings.RemindersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Heimdall.UI.Controls"
             xmlns:s="clr-namespace:Heimdall.Services">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Mesclado aqui também: StaticResource é resolvido no InitializeComponent. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Heimdall;component/Themes/Forms.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Linha de campo: rótulo + dica à esquerda, valor à direita. -->
            <Style x:Key="FieldRow" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,10"/>
                <Setter Property="LastChildFill" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock Text="{x:Static s:Strings.SectionLembretes}" Style="{StaticResource H.SectionTitle}"/>
        <TextBlock Text="{x:Static s:Strings.LembretesSubtitle}" Style="{StaticResource H.SectionSubtitle}"/>

        <!-- ============ Avisos ============ -->
        <TextBlock Text="{x:Static s:Strings.LabelReminderNotices}" Style="{StaticResource H.FieldLabel}"/>
        <Border Style="{StaticResource H.SettingsCard}" Padding="16,6" Margin="0,0,0,20">
            <StackPanel>
                <DockPanel Style="{StaticResource FieldRow}">
                    <TextBox DockPanel.Dock="Right" Style="{StaticResource H.MonoField}" Width="72" TextAlignment="Center"
                             VerticalAlignment="Center" Text="{Binding DefaultTimeText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static s:Strings.LabelDefaultTime}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static s:Strings.LabelDefaultTime}"/>
                        <TextBlock Text="{x:Static s:Strings.HintDefaultTime}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource H.Divider}"/>
                <DockPanel Style="{StaticResource FieldRow}">
                    <TextBox DockPanel.Dock="Right" Style="{StaticResource H.MonoField}" Width="72" TextAlignment="Center"
                             VerticalAlignment="Center" Text="{Binding SnoozeMinutesText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static s:Strings.LabelSnoozeMinutes}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static s:Strings.LabelSnoozeMinutes}"/>
                        <TextBlock Text="{x:Static s:Strings.HintSnoozeMinutes}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource H.Divider}"/>
                <CheckBox IsChecked="{Binding PlaySound, Mode=TwoWay}" Margin="0,8"
                          AutomationProperties.Name="{x:Static s:Strings.LabelReminderSound}">
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.LabelReminderSound}"/>
                        <TextBlock Text="{x:Static s:Strings.HintReminderSound}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource H.Divider}"/>
                <CheckBox IsChecked="{Binding ShowCompleted, Mode=TwoWay}" Margin="0,8"
                          AutomationProperties.Name="{x:Static s:Strings.LabelShowCompleted}">
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.LabelShowCompleted}"/>
                        <TextBlock Text="{x:Static s:Strings.HintShowCompleted}" Style="{StaticResource H.FieldHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- ============ Minhas listas: cor, nome, contagem, excluir ============ -->
        <TextBlock Text="{x:Static s:Strings.LabelMyListsSettings}" Style="{StaticResource H.FieldLabel}"/>
        <TextBlock Text="{x:Static s:Strings.HintMyLists}" Style="{StaticResource H.FieldHint}" Margin="0,-4,0,8"/>
        <Border Style="{StaticResource H.SettingsCard}" Padding="12,6">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Lists}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cor: clique troca pela próxima da paleta -->
                                <Button Style="{StaticResource ChipIconButtonStyle}" Command="{Binding CycleColorCommand}"
                                        AutomationProperties.Name="{x:Static s:Strings.ChangeListColor}" ToolTip="{x:Static s:Strings.ChangeListColor}">
                                    <Ellipse Width="16" Height="16" Fill="{Binding Brush}"/>
                                </Button>

                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="10,0"
                                         VerticalAlignment="Center" AutomationProperties.Name="{x:Static s:Strings.ListNameField}"/>

                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource H.FieldHint}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- Padrão não se exclui; as outras pedem um segundo toque -->
                                <TextBlock Grid.Column="3" Text="{x:Static s:Strings.DefaultListBadge}" Style="{StaticResource H.FieldHint}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDefault, Converter={StaticResource H.BoolToVis}}"/>
                                <Button Grid.Column="3" Content="{Binding DeleteLabel}"
                                        Command="{Binding DeleteCommand}" Tag="{Binding IsConfirmingDelete}"
                                        Foreground="{DynamicResource H.Brush.Danger}"
                                        AutomationProperties.Name="{Binding DeleteLabel}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{DynamicResource H.DashedButton}" Command="{Binding AddListCommand}" Margin="0,8,0,6" Height="36"
                        AutomationProperties.Name="{x:Static s:Strings.AddList}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Geometry="{DynamicResource H.Icon.Plus}" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static s:Strings.AddList}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
