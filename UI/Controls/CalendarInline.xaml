<UserControl x:Class="Heimdall.UI.Controls.CalendarInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Heimdall.UI.Controls"
             xmlns:s="clr-namespace:Heimdall.Services"
             AutomationProperties.Name="{x:Static s:Strings.CalendarName}">

    <UserControl.Resources>
        <!-- Seta de mês, 24px. -->
        <Style x:Key="MonthArrow" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="999" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dia: círculo 30px, número mono 11.5. Selecionado = acento cheio; hoje = anel 1.5
             no acento; outro mês = cor apagada. -->
        <Style x:Key="CalendarDay" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
            <Setter Property="FontFamily" Value="{DynamicResource H.Font.Mono}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="999" Background="Transparent" BorderThickness="0"
                                BorderBrush="{DynamicResource H.Brush.Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource H.Brush.Faint}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource H.Brush.OnAccent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Root">
        <!-- Sugestões: Hoje · Amanhã · Próxima segunda · +1 semana -->
        <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,6" Content="{Binding Label}"
                            Foreground="{DynamicResource H.Brush.Text}"
                            Command="{Binding DataContext.SelectCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Cabeçalho: "Outubro 2026" + setas -->
        <DockPanel Margin="4,0,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource MonthArrow}" Command="{Binding NextMonthCommand}"
                    AutomationProperties.Name="{x:Static s:Strings.CalendarNextMonth}" ToolTip="{x:Static s:Strings.CalendarNextMonth}">
                <c:Icon Geometry="{DynamicResource H.Icon.ChevronRight}" Size="14"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource MonthArrow}" Command="{Binding PreviousMonthCommand}" Margin="0,0,2,0"
                    AutomationProperties.Name="{x:Static s:Strings.CalendarPreviousMonth}" ToolTip="{x:Static s:Strings.CalendarPreviousMonth}">
                <c:Icon Geometry="{DynamicResource H.Icon.ChevronLeft}" Size="14"/>
            </Button>
            <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource H.Font.UI}" FontSize="{DynamicResource H.FontSize.M}"
                       FontWeight="SemiBold" Foreground="{DynamicResource H.Brush.Text}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- D S T Q Q S S -->
        <ItemsControl ItemsSource="{Binding WeekDays}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Letter}" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center"
                               FontFamily="{DynamicResource H.Font.UI}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource H.Brush.TextTertiary}" Margin="0,0,0,4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Grade: 6 semanas, setas navegam entre os dias (Tab entra/sai da grade uma vez só) -->
        <ItemsControl ItemsSource="{Binding Days}" Focusable="False"
                      KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Style="{StaticResource CalendarDay}" Content="{Binding Number}" Margin="0,1"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding DataContext.SelectCommand, ElementName=Root}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding AccessibleName}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
