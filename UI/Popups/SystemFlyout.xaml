<UserControl x:Class="Heimdall.UI.Popups.SystemFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Heimdall.UI.Controls"
             xmlns:s="clr-namespace:Heimdall.Services">

    <UserControl.Resources>
        <Style x:Key="MeterLabel" TargetType="TextBlock" BasedOn="{StaticResource H.Text}">
            <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        </Style>
        <Style x:Key="MeterValue" TargetType="TextBlock" BasedOn="{StaticResource H.Text.Mono}">
            <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ActionText" TargetType="TextBlock" BasedOn="{StaticResource H.Text}">
            <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Medidores -->
        <Grid Margin="2,0">
            <TextBlock Text="CPU" Style="{StaticResource MeterLabel}"/>
            <TextBlock Text="{Binding CpuText}" Style="{StaticResource MeterValue}"/>
        </Grid>
        <ProgressBar Style="{DynamicResource H.Meter}" Value="{Binding CpuPercent, Mode=OneWay}" Margin="2,6,2,12"
                     AutomationProperties.Name="CPU"/>

        <Grid Margin="2,0">
            <TextBlock Text="{x:Static s:Strings.SystemMemory}" Style="{StaticResource MeterLabel}"/>
            <TextBlock Text="{Binding RamText}" Style="{StaticResource MeterValue}"/>
        </Grid>
        <ProgressBar Style="{DynamicResource H.Meter}" Value="{Binding RamPercent, Mode=OneWay}" Margin="2,6,2,12"
                     AutomationProperties.Name="{x:Static s:Strings.SystemMemory}"/>

        <Grid Margin="2,0">
            <TextBlock Text="{x:Static s:Strings.SystemDisk}" Style="{StaticResource MeterLabel}"/>
            <TextBlock Text="{Binding DiskText}" Style="{StaticResource MeterValue}"/>
        </Grid>
        <ProgressBar Style="{DynamicResource H.Meter}" Value="{Binding DiskPercent, Mode=OneWay}" Margin="2,6,2,12"
                     AutomationProperties.Name="{x:Static s:Strings.SystemDisk}"/>

        <!-- Tempo ligado -->
        <StackPanel Orientation="Horizontal" Margin="2,0,2,0">
            <c:Icon Geometry="{DynamicResource H.Icon.Clock}" Size="14" Foreground="{DynamicResource H.Brush.TextTertiary}"/>
            <TextBlock Text="{Binding UptimeText}" Style="{DynamicResource H.Text.Secondary}" FontSize="{DynamicResource H.FontSize.S}"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Style="{DynamicResource H.Divider}" Margin="0,12,0,6"/>

        <!-- Ações -->
        <CheckBox Style="{DynamicResource H.Switch}" IsChecked="{Binding OverlayEnabled, Mode=TwoWay}" Margin="8,4,8,4" MinHeight="24"
                  AutomationProperties.Name="{x:Static s:Strings.ActionOverlayMode}">
            <StackPanel Orientation="Horizontal">
                <c:Icon Geometry="{DynamicResource H.Icon.Gamepad}" Size="14"/>
                <TextBlock Text="{x:Static s:Strings.ActionOverlayMode}" Style="{StaticResource ActionText}" Margin="10,0,0,0"/>
            </StackPanel>
        </CheckBox>

        <Button Style="{DynamicResource H.ListButton}" Command="{Binding HideBarCommand}"
                AutomationProperties.Name="{x:Static s:Strings.ActionHideBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+H" Style="{DynamicResource H.Text.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource H.Brush.TextTertiary}" VerticalAlignment="Center"/>
                <c:Icon Geometry="{DynamicResource H.Icon.EyeOff}" Size="14"/>
                <TextBlock Text="{x:Static s:Strings.ActionHideBar}" Style="{StaticResource ActionText}" Margin="10,0,0,0"/>
            </DockPanel>
        </Button>

        <Button Style="{DynamicResource H.ListButton}" Command="{Binding SettingsCommand}"
                AutomationProperties.Name="{x:Static s:Strings.ActionSettings}">
            <StackPanel Orientation="Horizontal">
                <c:Icon Geometry="{DynamicResource H.Icon.Settings}" Size="14"/>
                <TextBlock Text="{x:Static s:Strings.ActionSettings}" Style="{StaticResource ActionText}" Margin="10,0,0,0"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
