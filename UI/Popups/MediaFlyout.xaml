<UserControl x:Class="Heimdall.UI.Popups.MediaFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Heimdall.UI.Controls"
             xmlns:s="clr-namespace:Heimdall.Services">

    <StackPanel>
        <!-- Capa 56 + título/artista -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource H.Brush.Selected}">
                <c:Icon Geometry="{DynamicResource H.Icon.Music}" Size="22" Foreground="{DynamicResource H.Brush.TextTertiary}"/>
            </Border>
            <!-- Capa por cima do ícone; o raio vem do Border (ImageBrush no fundo é recortado por ele). -->
            <Border Width="56" Height="56" CornerRadius="10">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource H.Text}" FontSize="{DynamicResource H.FontSize.L}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Artist}" Style="{DynamicResource H.Text.Secondary}" FontSize="{DynamicResource H.FontSize.M}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Seekbar + tempos -->
        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource H.BoolToVis}}">
            <Slider x:Name="Seek" Style="{DynamicResource H.Slider}" Minimum="0" Maximum="{Binding Duration}"
                    Value="{Binding Position, Mode=TwoWay}" SmallChange="5" LargeChange="15"
                    AutomationProperties.Name="{x:Static s:Strings.MediaSeek}"/>
            <Grid Margin="0,4,0,0">
                <TextBlock Text="{Binding PositionText}" Style="{DynamicResource H.Text.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource H.Brush.TextTertiary}"/>
                <TextBlock Text="{Binding DurationText}" Style="{DynamicResource H.Text.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource H.Brush.TextTertiary}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Controles 38 / 46 / 38 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Style="{DynamicResource H.IconButton}" Width="38" Height="38" Command="{Binding PreviousCommand}"
                    AutomationProperties.Name="{x:Static s:Strings.MediaPrevious}" ToolTip="{x:Static s:Strings.MediaPrevious}">
                <c:Icon Geometry="{DynamicResource H.Icon.Previous}" Size="16" Filled="True"/>
            </Button>
            <Button Style="{DynamicResource H.RoundAccentButton}" Margin="14,0" Command="{Binding PlayPauseCommand}"
                    AutomationProperties.Name="{x:Static s:Strings.MediaPlayPauseTooltip}" ToolTip="{x:Static s:Strings.MediaPlayPauseTooltip}">
                <c:Icon Size="18" Filled="True">
                    <c:Icon.Style>
                        <Style TargetType="c:Icon">
                            <Setter Property="Geometry" Value="{DynamicResource H.Icon.Play}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Geometry" Value="{DynamicResource H.Icon.Pause}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:Icon.Style>
                </c:Icon>
            </Button>
            <Button Style="{DynamicResource H.IconButton}" Width="38" Height="38" Command="{Binding NextCommand}"
                    AutomationProperties.Name="{x:Static s:Strings.MediaNext}" ToolTip="{x:Static s:Strings.MediaNext}">
                <c:Icon Geometry="{DynamicResource H.Icon.Next}" Size="16" Filled="True"/>
            </Button>
        </StackPanel>

        <Border Style="{DynamicResource H.Divider}" Margin="0,14,0,10"/>

        <!-- Volume do app -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Button Style="{DynamicResource H.IconButton}" Command="{Binding ToggleMuteCommand}"
                    AutomationProperties.Name="{x:Static s:Strings.MediaMute}" ToolTip="{x:Static s:Strings.MediaMute}">
                <c:Icon Size="16">
                    <c:Icon.Style>
                        <Style TargetType="c:Icon">
                            <Setter Property="Geometry" Value="{DynamicResource H.Icon.Volume}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="Geometry" Value="{DynamicResource H.Icon.VolumeMute}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:Icon.Style>
                </c:Icon>
            </Button>
            <Slider Grid.Column="1" Style="{DynamicResource H.Slider}" Margin="8,0" VerticalAlignment="Center"
                    Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Static s:Strings.MediaAppVolume}"/>
            <TextBlock Grid.Column="2" Style="{DynamicResource H.Text.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource H.Brush.TextSecondary}"
                       Text="{Binding Volume, StringFormat={}{0:0}%}"/>
        </Grid>
    </StackPanel>
</UserControl>
