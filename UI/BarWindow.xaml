<Window x:Class="Heimdall.UI.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heimdall"
        Icon="pack://application:,,,/Assets/heimdall.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent">

    <Border x:Name="Root" AllowDrop="True" Background="{DynamicResource H.Brush.BarBg}" DragEnter="Root_DragEnter" Drop="Root_Drop"
            PreviewMouseRightButtonDown="Root_PreviewMouseRightButtonDown"
            MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp" LostMouseCapture="Root_LostMouseCapture">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="SettingsMenuItem" Click="OpenSettings_Click" />
                <MenuItem x:Name="EditConfigMenuItem" Click="OpenConfig_Click" />
                <MenuItem x:Name="ReminderHistoryMenuItem" Click="OpenReminderHistory_Click" />
                <MenuItem x:Name="AddShortcutMenu">
                    <MenuItem x:Name="AddShortcutFromFileMenuItem" Click="AddLauncherFromFile_Click" />
                    <MenuItem x:Name="AddShortcutFromInstalledMenuItem" Click="AddLauncherFromInstalled_Click" />
                </MenuItem>
                <MenuItem x:Name="AddSeparatorMenuItem" Click="AddSeparator_Click" />
                <MenuItem x:Name="AddWidgetMenu" />
                <MenuItem x:Name="ThemeMenu" />
                <MenuItem x:Name="GamingModeMenuItem" IsCheckable="True" Click="GamingMode_Click" />
                <MenuItem x:Name="ReloadMenuItem" Click="Reload_Click" />
                <MenuItem x:Name="MonitorsMenuItem" Click="Monitors_Click" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Botão de atualização fora das zonas (não é widget: não arrasta, não fixa), na
                 ponta final da barra; só aparece quando tem versão nova no GitHub. -->
            <DockPanel x:Name="BarContent" LastChildFill="True">
                <Button x:Name="UpdateButton" Visibility="Collapsed" Click="UpdateButton_Click"
                        Style="{StaticResource H.IconButton}" Margin="2,0" />

                <!-- Três zonas: início / centro / fim (colunas Auto / * / Auto, ou linhas na vertical) -->
                <Grid x:Name="Zones">
                    <StackPanel x:Name="StartZone" />
                    <StackPanel x:Name="CenterZone" />
                    <StackPanel x:Name="EndZone" />
                </Grid>
            </DockPanel>

            <!-- Fio de acento do tema Bifröst (espessura 0 nos outros temas). -->
            <Border x:Name="AccentLine" Background="{DynamicResource H.Brush.Accent}" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
