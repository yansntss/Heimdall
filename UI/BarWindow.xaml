<Window x:Class="InfoBar.UI.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InfoBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">

    <Border x:Name="Root">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Configurações..." Click="OpenSettings_Click" />
                <MenuItem Header="Editar config.json" Click="OpenConfig_Click" />
                <MenuItem Header="Tema" x:Name="ThemeMenu" />
                <MenuItem Header="Recarregar" Click="Reload_Click" />
                <MenuItem Header="Monitores detectados" Click="Monitors_Click" />
                <Separator />
                <MenuItem Header="Sair" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Três zonas sobrepostas na mesma célula: início / centro / fim -->
        <Grid x:Name="Zones">
            <StackPanel x:Name="StartZone" />
            <StackPanel x:Name="CenterZone" />
            <StackPanel x:Name="EndZone" />
        </Grid>
    </Border>
</Window>
