<Window x:Class="InfoBar.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InfoBar Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">

    <Border x:Name="Root">
        <!-- Três zonas sobrepostas na mesma célula: início / centro / fim -->
        <Grid x:Name="Zones">
            <StackPanel x:Name="StartZone" />
            <StackPanel x:Name="CenterZone" />
            <StackPanel x:Name="EndZone" />
        </Grid>
    </Border>
</Window>
