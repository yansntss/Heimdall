<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Heimdall.UI.Controls"
                    xmlns:s="clr-namespace:Heimdall.Services">

    <!-- Estilos base reaproveitados pela barra, popups, menus e Configurações. Só
         estilos com chave (H.*): nada aqui muda controles que não pediram o estilo.
         Toda cor vem de {DynamicResource H.Brush.*} — troca de tema/acento é ao vivo. -->

    <BooleanToVisibilityConverter x:Key="H.BoolToVis"/>

    <!-- ===================== Foco por teclado ===================== -->
    <Style x:Key="H.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="9" BorderThickness="1.5"
                            BorderBrush="{DynamicResource H.Brush.Accent}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Texto ===================== -->
    <Style x:Key="H.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="H.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource H.Text}">
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.XS}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="H.Text.Tertiary" TargetType="TextBlock" BasedOn="{StaticResource H.Text}">
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.XS}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextTertiary}"/>
    </Style>

    <Style x:Key="H.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource H.Text}">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.XS}"/>
    </Style>

    <!-- Rótulo de seção em caixa alta ("HOJE", "WIDGET · MÍDIA"). -->
    <Style x:Key="H.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource H.Text}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextTertiary}"/>
    </Style>

    <!-- ===================== Botão de ícone (30x30, raio 8) ===================== -->
    <Style x:Key="H.IconButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource H.Size.IconButton}"/>
        <Setter Property="Height" Value="{DynamicResource H.Size.IconButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource H.Radius.Item}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mesmo visual, alternável (popup aberto = selecionado). -->
    <Style x:Key="H.IconToggleButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="{DynamicResource H.Size.IconButton}"/>
        <Setter Property="Height" Value="{DynamicResource H.Size.IconButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource H.Radius.Item}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Botões de texto ===================== -->
    <Style x:Key="H.SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource H.Brush.Selected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource H.Radius.Item}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primário: fundo acento, texto #15181F. -->
    <Style x:Key="H.PrimaryButton" TargetType="Button" BasedOn="{StaticResource H.SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource H.Brush.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource H.Radius.Item}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.76"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Switch (36x20) ===================== -->
    <Style x:Key="H.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10"
                                Background="{DynamicResource H.Brush.Track}" BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource H.Brush.TextSecondary}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource H.Brush.Accent}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource H.Brush.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider (seekbar / volume) ===================== -->
    <Style x:Key="H.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource H.Brush.Accent}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="H.SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="H.SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="16" Height="16" Background="Transparent">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource H.Brush.Text}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14"/>
                            <Setter TargetName="Knob" Property="Height" Value="14"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Trilho 4px, parte preenchida no acento, thumb 12px. Setas do teclado movem 1 passo. -->
    <Style x:Key="H.Slider" TargetType="Slider">
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="SmallChange" Value="1"/>
        <Setter Property="LargeChange" Value="5"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource H.Brush.Track}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource H.SliderFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource H.SliderRest}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource H.SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Medidor (barra 5px) ===================== -->
    <Style x:Key="H.Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2.5" Background="{DynamicResource H.Brush.Track}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Círculo de concluir tarefa (21px) ===================== -->
    <!-- Pendente = anel vazio; concluído = verde-água com check. Width/Height locais mudam o
         tamanho (o sino usa 18px). Mesmo controle no sino e na janela de lembretes. -->
    <Style x:Key="H.TaskCheck" TargetType="CheckBox">
        <Setter Property="Width" Value="21"/>
        <Setter Property="Height" Value="21"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource H.Brush.Muted}" StrokeThickness="1.5"/>
                        <c:Icon x:Name="Mark" Geometry="{DynamicResource H.Icon.Check}" Size="11" StrokeThickness="3"
                                Foreground="{DynamicResource H.Brush.OnAccent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource H.Brush.Ok}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource H.Brush.Ok}"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="0"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource H.Brush.Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Botão tracejado ("Novo lembrete", 36px) ===================== -->
    <Style x:Key="H.DashedButton" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Dash" RadiusX="9" RadiusY="9" StrokeThickness="1" StrokeDashArray="4 3"
                                   Stroke="{DynamicResource H.Brush.Muted}" Fill="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource H.Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Linha de ação (32px, raio 8) ===================== -->
    <!-- Conteúdo ocupa a largura toda: ícone à esquerda, texto, atalho/valor à direita. -->
    <Style x:Key="H.ListButton" TargetType="ButtonBase">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource H.Radius.Item}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Botão redondo de ação principal (play 46) ===================== -->
    <Style x:Key="H.RoundAccentButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource H.Brush.Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Card de popup (dropdowns da barra) ===================== -->
    <!-- Raio 14, #12161E @ 94%, borda 9%, sombra 0 18 40 rgba(0,0,0,.45), largura 300. -->
    <DropShadowEffect x:Key="H.Shadow.Popup" BlurRadius="40" ShadowDepth="18" Direction="270" Color="Black" Opacity="0.45"/>

    <Style x:Key="H.PopupCard" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource H.Size.PopupWidth}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource H.Radius.Popup}"/>
        <Setter Property="Background" Value="{DynamicResource H.Brush.SurfacePopup}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect" Value="{StaticResource H.Shadow.Popup}"/>
    </Style>

    <!-- ===================== Divisores ===================== -->
    <Style x:Key="H.Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="H.DividerVertical" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== Switch 38x22 (ToggleButton) ===================== -->
    <!-- Só o trilho: o rótulo fica na linha (DetailSwitchRowStyle). Espaço alterna. -->
    <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource H.Brush.Track}"
                            BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"
                                 Fill="{DynamicResource H.Brush.TextSecondary}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource H.Brush.Accent}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource H.Brush.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Chip 28px, raio 999 ===================== -->
    <!-- Tag=True = preenchido (acento @16%, texto no acento). -->
    <Style x:Key="ChipButtonStyle" TargetType="ButtonBase">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.S}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" CornerRadius="999" Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource H.Brush.Line}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <!-- DataTrigger: Tag é object, e um Trigger compararia com o texto "True". -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.AccentChip}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource H.Brush.Accent}"/>
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip só-ícone 28x28 (bandeira, nota, "…"). Precisa de AutomationProperties.Name. -->
    <Style x:Key="ChipIconButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource ChipButtonStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ===================== Linha de detalhe 44px ===================== -->
    <!-- Content = rótulo à esquerda; Tag = valor à direita (texto secundário) + chevron. -->
    <Style x:Key="DetailRowStyle" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="12,0,6,0" TextElement.Foreground="{DynamicResource H.Brush.TextSecondary}"/>
                            <c:Icon Grid.Column="2" Geometry="{DynamicResource H.Icon.ChevronRight}" Size="14"
                                    Foreground="{DynamicResource H.Brush.TextTertiary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linha de detalhe com switch à direita: a linha inteira é o ToggleButton (Espaço alterna). -->
    <Style x:Key="DetailSwitchRowStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <!-- Trilho do switch (mesmo visual do SwitchToggleStyle), só desenho. -->
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                    Background="{DynamicResource H.Brush.Track}" BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource H.Brush.TextSecondary}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource H.Brush.Accent}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource H.Brush.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Lista de opções com check (40px) ===================== -->
    <!-- ListBox de escolha única no lugar de RadioButton: selecionado = check 14px no acento à direita. -->
    <Style x:Key="OptionRowStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <c:Icon x:Name="Check" Grid.Column="1" Geometry="{DynamicResource H.Icon.Check}" Size="14" StrokeThickness="2.4"
                                    Foreground="{DynamicResource H.Brush.Accent}" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Estado vazio: "Tudo em ordem" ===================== -->
    <!-- Check em círculo de 38px (verde-água @14%), "Tudo em ordem" e, como Content, a
         segunda linha (o próximo lembrete futuro). -->
    <Style x:Key="H.AllClearCard" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="AutomationProperties.Name" Value="{x:Static s:Strings.AllClear}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource H.Brush.Card}" BorderBrush="{DynamicResource H.Brush.Line}" BorderThickness="1"
                            CornerRadius="12" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="38" Height="38" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource H.Brush.OkWash}"/>
                                <c:Icon Geometry="{DynamicResource H.Icon.Check}" Size="18" StrokeThickness="2.4" Foreground="{DynamicResource H.Brush.Ok}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static s:Strings.AllClear}" Style="{StaticResource H.Text}" FontSize="{DynamicResource H.FontSize.M}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource H.Text.Secondary}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Círculo de dia da semana (38px) ===================== -->
    <!-- Selecionado = fundo acento, texto escuro; solto = borda @14%, texto suave. -->
    <Style x:Key="DayCircleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSoft}"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="999" Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource H.Brush.Ring}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource H.Brush.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
