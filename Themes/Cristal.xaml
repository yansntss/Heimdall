<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Cristal: claro translúcido — texto #15181F, bordas #15181F a 10%. -->
    <!-- Só cores e métricas: os pincéis (com acento e opacidade aplicados) são gerados pelo ThemeManager. -->

    <Color x:Key="H.Color.BarBg">#F3F5F9</Color>
    <sys:Double x:Key="H.Theme.BarOpacity">0.72</sys:Double>
    <sys:String x:Key="H.Theme.Backdrop">Acrylic</sys:String>
    <sys:Double x:Key="H.Theme.AccentLine">0</sys:Double>
    <sys:Double x:Key="H.Size.BarHeight">38</sys:Double>
    <sys:Boolean x:Key="H.Theme.IsCompact">False</sys:Boolean>
    <sys:Boolean x:Key="H.Theme.IsLight">True</sys:Boolean>

    <Color x:Key="H.Color.Surface">#F6F7FA</Color>
    <Color x:Key="H.Color.Elevated">#FBFCFD</Color>
    <Color x:Key="H.Color.Line">#1A15181F</Color>
    <Color x:Key="H.Color.Text">#15181F</Color>
    <Color x:Key="H.Color.TextSecondary">#4A5363</Color>
    <Color x:Key="H.Color.TextTertiary">#6B7484</Color>
    <Color x:Key="H.Color.Accent">#E0B562</Color>
    <Color x:Key="H.Color.OnAccent">#15181F</Color>
    <Color x:Key="H.Color.Ok">#2E8C7E</Color>
    <Color x:Key="H.Color.Danger">#C4573C</Color>
    <!-- Base dos estados de hover (7%), pressed (12%) e selecionado (8%). -->
    <Color x:Key="H.Color.Overlay">#15181F</Color>
    <Color x:Key="H.Color.Muted">#8A96A6</Color>

</ResourceDictionary>
