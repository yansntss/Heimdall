<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Heimdall.UI.Controls">

    <!-- Estilos de formulário da janela de Configurações. Implícitos de propósito, mas só
         valem onde este dicionário é mesclado (Window.Resources da SettingsWindow) — nada
         aqui vaza pra barra ou pros popups. Toda cor via {DynamicResource H.Brush.*}. -->

    <!-- ===================== Texto ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
    </Style>

    <Style x:Key="H.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="H.SectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="H.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="H.FieldHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.XS}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="H.MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.S}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
    </Style>

    <!-- Agrupa campos relacionados (fundo levemente destacado, raio 12). -->
    <Style x:Key="H.SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource H.Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ===================== Campos ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource H.Brush.Field}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource H.Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource H.Brush.AccentSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource H.Radius.Item}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource H.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo numérico curto (opacidade, altura). -->
    <Style x:Key="H.MonoField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.Mono}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,6"/>
    </Style>

    <Style x:Key="H.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource H.Brush.Field}" BorderBrush="{DynamicResource H.Brush.Line}"
                            BorderThickness="1" CornerRadius="{DynamicResource H.Radius.Item}">
                        <c:Icon Geometry="{DynamicResource H.Icon.ChevronDown}" Size="14" HorizontalAlignment="Right" Margin="0,0,8,0"
                                Foreground="{DynamicResource H.Brush.TextSecondary}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource H.Radius.MenuItem}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource H.ComboToggle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" BorderThickness="0"
                                 Margin="2,0,24,0" VerticalAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource H.Brush.Elevated}" BorderBrush="{DynamicResource H.Brush.Line}"
                                    BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" Padding="4" MaxHeight="280"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle = switch 36x20 (rótulo à esquerda, chave à direita). -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource H.Switch}"/>
    <Style TargetType="Slider" BasedOn="{StaticResource H.Slider}"/>
    <Style TargetType="Button" BasedOn="{StaticResource H.SecondaryButton}"/>

    <!-- ===================== Barra de rolagem fina ===================== -->
    <Style x:Key="H.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="{DynamicResource H.Brush.Track}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource H.ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2,1">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource H.ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Listas ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource H.Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource H.Radius.MenuItem}" Margin="0,1"
                            Padding="{TemplateBinding Padding}" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Itens da sidebar: 38px, raio 8, selecionado = branco @ 8%. -->
    <Style x:Key="H.NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource H.Radius.Item}" Margin="0,1"
                            Padding="{TemplateBinding Padding}" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card de opção (posição, tema): borda 1 na cor de linha; selecionado = borda 1.5 no acento. -->
    <Style x:Key="H.OptionCard" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource H.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource H.Brush.Card}" BorderBrush="{DynamicResource H.Brush.Line}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource H.Brush.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista "sem moldura" que só organiza cards/opções. -->
    <Style x:Key="H.BareList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tabela (lembretes) ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource H.Brush.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource H.Brush.Sidebar}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource H.Font.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.M}"/>
        <Setter Property="RowHeight" Value="32"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource H.Brush.Sidebar}"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource H.FontSize.XS}"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource H.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource H.Brush.Selected}"/>
                <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Chrome da janela (34x28) ===================== -->
    <Style x:Key="H.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource H.Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource H.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="H.CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource H.CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Brush.Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource H.Brush.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
