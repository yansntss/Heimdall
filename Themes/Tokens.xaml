<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Tokens que não mudam entre temas: tipografia, raios, espaçamento e tamanhos.
         As cores ficam em Themes/<Tema>.xaml e os pincéis são gerados pelo ThemeManager
         (acento e opacidade da barra são trocáveis em runtime). -->

    <!-- ===================== Tipografia ===================== -->
    <!-- Manrope / JetBrains Mono embutidas (OFL, ver Assets/Fonts); se faltar glifo cai na fonte do sistema.
         Caminho relativo a este arquivo de propósito: "pack://application:,,,/..." absoluto não
         resolve fonte embutida no FontFamily (só com URI base). -->
    <FontFamily x:Key="H.Font.UI">../Assets/Fonts/#Manrope, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="H.Font.Mono">../Assets/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="H.FontSize.XS">11</sys:Double>
    <sys:Double x:Key="H.FontSize.S">11.5</sys:Double>
    <sys:Double x:Key="H.FontSize.M">12.5</sys:Double>
    <sys:Double x:Key="H.FontSize.L">14</sys:Double>

    <!-- ===================== Raios ===================== -->
    <CornerRadius x:Key="H.Radius.Chip">6</CornerRadius>
    <CornerRadius x:Key="H.Radius.Item">8</CornerRadius>
    <CornerRadius x:Key="H.Radius.MenuItem">7</CornerRadius>
    <CornerRadius x:Key="H.Radius.Popup">14</CornerRadius>
    <CornerRadius x:Key="H.Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="H.Radius.Window">14</CornerRadius>

    <!-- ===================== Espaçamento (base 4) ===================== -->
    <sys:Double x:Key="H.Space.1">4</sys:Double>
    <sys:Double x:Key="H.Space.2">8</sys:Double>
    <sys:Double x:Key="H.Space.3">12</sys:Double>
    <sys:Double x:Key="H.Space.4">16</sys:Double>

    <!-- ===================== Tamanhos ===================== -->
    <sys:Double x:Key="H.Size.IconButton">30</sys:Double>
    <sys:Double x:Key="H.Size.Icon">16</sys:Double>
    <sys:Double x:Key="H.Size.IconSmall">14</sys:Double>
    <sys:Double x:Key="H.Size.Chip">28</sys:Double>
    <sys:Double x:Key="H.Size.MenuItem">32</sys:Double>
    <sys:Double x:Key="H.Size.PopupWidth">300</sys:Double>
    <Thickness x:Key="H.Padding.Bar">10,0,10,0</Thickness>

</ResourceDictionary>
