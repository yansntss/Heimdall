<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM com SDK do Windows 10: necessário na fase 3 (SMTC / mídia) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Heimdall</RootNamespace>
    <AssemblyName>Heimdall</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\heimdall.ico</ApplicationIcon>
    <!-- O csproj fica na raiz: sem isso o glob padrão compilaria os testes (e o material do brag) dentro do app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;brag-output\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heimdall.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>Heimdall</Product>
    <Company>Heimdall</Company>
    <Description>Barra de informações para Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só a referência (sem UseWindowsForms=true) para não colidir com os "global using"
         do WPF em Orientation/Color/TextBox/etc. Usado só pelo ColorDialog nativo. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\heimdall.ico" />
    <Resource Include="Assets\heimdall-logo.png" />
    <!-- Manrope (UI) e JetBrains Mono (números/atalhos), ambas OFL — licenças ao lado dos arquivos. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Só a Core Audio API (volume por app do widget de mídia) — evita puxar Midi/Asio/Dmo/WinMM/WinForms do pacote NAudio completo. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Sensores de temperatura de CPU/GPU (widget "temp") — WMI/MSAcpi_ThermalZoneTemperature é pouco confiável em hardware moderno. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

</Project>
